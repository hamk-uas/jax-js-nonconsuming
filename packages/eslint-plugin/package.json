{
  "name": "@hamk-uas/eslint-plugin-jax-js",
  "version": "0.1.2",
  "description": "ESLint rules for jax-js array ownership — enforces deterministic disposal and prevents memory leaks",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "/dist/*.{js,cjs,d.ts,d.cts}"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "jax-js",
    "memory",
    "ownership",
    "dispose",
    "gpu",
    "webgpu",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamk-uas/jax-js-nonconsuming.git",
    "directory": "packages/eslint-plugin"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  }
}
