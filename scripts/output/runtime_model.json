  "_runtimeUsage": {
    "_doc": "Pseudocode for runtime inference at device init",
    "steps": [
      "// 1. Classify vendor from features + maxBufferSize",
      "const vc = classifyVendor(device.features, device.limits.maxBufferSize);",
      "const model = RUNTIME_MODEL.vendorModels[vc] ?? RUNTIME_MODEL.globalFallback;",
      "",
      "// 2. For Apple: prefer exact architecture lookup",
      "if (vc === 'apple' && adapterInfo?.architecture) {",
      "  const gen = RUNTIME_MODEL.appleLookup[adapterInfo.architecture];",
      "  if (gen) return { B_mem: gen.bw_geomean, T_alu: gen.tf_geomean, ...model };",
      "  // Safari fallback: use conservative P25",
      "  const fb = RUNTIME_MODEL.appleLookup._safari_fallback;",
      "  return { B_mem: fb.bw_p25, T_alu: fb.tf_p25, ...model };",
      "}",
      "",
      "// 3. For classes with good regression: continuous inference",
      "if (model.regressionUsable) {",
      "  const logBuf = Math.log(device.limits.maxBufferSize);",
      "  const logBw  = model.bufToBw.a + model.bufToBw.b * logBuf;",
      "  const logTf  = model.bwToTf.a + model.bwToTf.b * logBw;",
      "  return { B_mem: Math.exp(logBw), T_alu: Math.exp(logTf), ...model };",
      "}",
      "",
      "// 4. For low-data classes: median fallback",
      "return { B_mem: model.median.bw_geomean, T_alu: model.median.tf_geomean, ...model };"
    ]
  },
