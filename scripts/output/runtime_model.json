  "featureClassifier": {
    "_doc": "Two-stage decision tree: (1) features-bitmap → family, (2) maxBufferSize → discrete vs IGP. Evaluate conditions top-to-bottom, first match wins.",
    "igpThreshold_bytes": 5368709120,
    "rules": [
      {
        "condition": "etc2 && astc && f16",
        "vendorClass": "apple",
        "description": "Apple Silicon (M1–M4): ETC2+ASTC mobile formats + shader-f16, no BC. Note: maxBufferSize doesn't discriminate within Apple — use adapterInfo.architecture for generation-specific lookup when available (Chrome only)."
      },
      {
        "condition": "etc2 && astc && !f16",
        "vendorClass": "mobile",
        "description": "Mobile SoC (Adreno/Mali): ETC2+ASTC without shader-f16"
      },
      {
        "condition": "bc && maxBufferSize <= igpThreshold",
        "vendorClass": "igp",
        "description": "Integrated graphics (Intel UHD/Iris Xe, AMD APU): desktop features but ≤4GB effective VRAM"
      },
      {
        "condition": "bc && f16 && subgroups",
        "vendorClass": "discrete-modern",
        "description": "Modern desktop discrete (Turing+, RDNA2+, Arc): BC + f16 + subgroups + >4GB VRAM"
      },
      {
        "condition": "bc && timestamp-query",
        "vendorClass": "discrete-legacy",
        "description": "Older desktop discrete (RDNA1): BC + timestamp-query but no f16, >4GB VRAM"
      },
      {
        "condition": "bc",
        "vendorClass": "discrete-minimal",
        "description": "Minimal desktop: only BC compression, >4GB VRAM"
      },
      {
        "condition": "true",
        "vendorClass": "unknown",
        "description": "Absolute fallback: no recognizable features"
      }
    ]
  },
