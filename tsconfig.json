{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.AsyncIterable", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@hamk-uas/jax-js-nonconsuming": ["."],
      "@hamk-uas/jax-js-nonconsuming-optax": ["./packages/optax/src"],
      "@hamk-uas/jax-js-nonconsuming-onnx": ["./packages/onnx/src"],
      "@hamk-uas/jax-js-nonconsuming-loaders": ["./packages/loaders/src"],
      "@hamk-uas/eslint-plugin-jax-js": [
        "./packages/eslint-plugin/src"
      ]
    },
    "types": ["@webgpu/types"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": [
    "**/node_modules",
    "**/*.config.js",
    "**/dist",
    "website",
    "test/deno",
    "tmp"
  ]
}
