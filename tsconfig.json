{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.AsyncIterable", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@jax-js-nonconsuming/jax": ["."],
      "@jax-js-nonconsuming/optax": ["./packages/optax/src"],
      "@jax-js-nonconsuming/onnx": ["./packages/onnx/src"],
      "@jax-js-nonconsuming/loaders": ["./packages/loaders/src"],
      "@jax-js-nonconsuming/eslint-plugin-jax-js": ["./packages/eslint-plugin/src"]
    },
    "types": ["@webgpu/types"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": [
    "**/node_modules",
    "**/*.config.js",
    "**/dist",
    "website",
    "test/deno",
    "tmp"
  ]
}
