+export async function waitWhileStateAsync(
+  control: Int32Array,
+  index: number,
+  expected: number,
+): Promise<void> {
+  const atomicsWithWaitAsync = Atomics as AtomicsWithWaitAsync;
+  const waitAsync = atomicsWithWaitAsync.waitAsync;
+  if (waitAsync) {
+    const result = waitAsync(control, index, expected);
+    if (result.async) {
+      await result.value;
+    }
+    return;
+  }
