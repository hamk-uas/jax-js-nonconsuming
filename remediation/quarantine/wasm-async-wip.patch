+/**
+ * QR cutoff benchmark for the WASM backend.
+ *
+ * Focus:
+ * - compare the current public small-shape polyfill against the direct routine path
+ * - measure the 8 -> 9 threshold in eager and jit execution
+ *
+ * Run with:
+ *   pnpm build && pnpm vitest bench bench/qr.bench.ts
+ */
+import {
+  blockUntilReady,
+  defaultDevice,
+  init,
+  jit,
+  lax,
+  numpy as np,
+  random,
+} from "@hamk-uas/jax-js-nonconsuming";
+import { afterAll, bench, describe } from "vitest";
+
+import { qr as primitiveQr } from "../src/frontend/core";
+
+await init("wasm");
+defaultDevice("wasm");
+
+type MatrixSpec = {
+  label: string;
+  shape: [number, number];
+  seed: number;
+  comparePrimitive?: boolean;
+};
+
+const eagerSpecs: MatrixSpec[] = [
+  { label: "8x8", shape: [8, 8], seed: 0, comparePrimitive: true },
+  { label: "9x9", shape: [9, 9], seed: 1 },
+  { label: "12x12", shape: [12, 12], seed: 2 },
+  { label: "16x8", shape: [16, 8], seed: 3, comparePrimitive: true },
+  { label: "16x9", shape: [16, 9], seed: 4 },
+];
+
+function makeMatrix(shape: [number, number], seed: number) {
+  const key = random.key(seed);
+  const matrix = random.uniform(key, shape);
+  key.dispose();
+  return matrix;
+}
+
+async function warmupQr(fn: () => [np.Array, np.Array]) {
+  const [q, r] = fn();
+  await blockUntilReady([q, r]);
+  q.dispose();
+  r.dispose();
+}
+
+const eagerCases: Array<{ spec: MatrixSpec; a: np.Array }> = [];
+for (const spec of eagerSpecs) {
+  const a = makeMatrix(spec.shape, spec.seed);
+  await warmupQr(() => np.linalg.qr(a));
+  if (spec.comparePrimitive) {
+    await warmupQr(() => primitiveQr(a) as [np.Array, np.Array]);
+  }
+  eagerCases.push({ spec, a });
+}
+
+afterAll(() => {
+  for (const { a } of eagerCases) a.dispose();
+});
+
+describe("QR cutoff (WASM eager)", () => {
+  for (const { spec, a } of eagerCases) {
+    bench(`public eager ${spec.label}`, async () => {
+      const [q, r] = np.linalg.qr(a);
+      await blockUntilReady([q, r]);
+      q.dispose();
+      r.dispose();
+    });
+
+    if (spec.comparePrimitive) {
+      bench(`primitive eager ${spec.label}`, async () => {
+        const [q, r] = primitiveQr(a) as [np.Array, np.Array];
+        await blockUntilReady([q, r]);
+        q.dispose();
+        r.dispose();
+      });
+    }
+  }
+});
+
+const jitSpecs: MatrixSpec[] = [
+  { label: "8x8", shape: [8, 8], seed: 10, comparePrimitive: true },
+  { label: "9x9", shape: [9, 9], seed: 11 },
+  { label: "16x8", shape: [16, 8], seed: 12, comparePrimitive: true },
+  { label: "16x9", shape: [16, 9], seed: 13 },
+];
+
+const jitCases: Array<{
+  spec: MatrixSpec;
+  a: np.Array;
+  f: (x: np.Array) => [np.Array, np.Array];
+  primitiveF?: (x: np.Array) => [np.Array, np.Array];
+}> = [];
+for (const spec of jitSpecs) {
+  const a = makeMatrix(spec.shape, spec.seed);
+  const f = jit((x: np.Array) => np.linalg.qr(x)) as (x: np.Array) => [
+    np.Array,
+    np.Array,
+  ];
+  await warmupQr(() => f(a));
+  let primitiveF:
+    | ((x: np.Array) => [np.Array, np.Array])
+    | undefined = undefined;
+  if (spec.comparePrimitive) {
+    primitiveF = jit((x: np.Array) => primitiveQr(x) as [np.Array, np.Array]) as (
+      x: np.Array,
+    ) => [np.Array, np.Array];
+    await warmupQr(() => primitiveF!(a));
+  }
+  jitCases.push({ spec, a, f, primitiveF });
+}
+
+afterAll(() => {
+  for (const { a, f, primitiveF } of jitCases) {
+    a.dispose();
+    (f as unknown as { dispose: () => void }).dispose();
+    if (primitiveF)
+      (primitiveF as unknown as { dispose: () => void }).dispose();
+  }
+});
+
+describe("QR cutoff (WASM jit)", () => {
+  for (const { spec, a, f, primitiveF } of jitCases) {
+    bench(`public jit ${spec.label}`, async () => {
+      const [q, r] = f(a);
+      await blockUntilReady([q, r]);
+      q.dispose();
+      r.dispose();
+    });
+
+    if (primitiveF) {
+      bench(`primitive jit ${spec.label}`, async () => {
+        const [q, r] = primitiveF(a);
+        await blockUntilReady([q, r]);
+        q.dispose();
+        r.dispose();
+      });
+    }
+  }
+});
+
+type ScanSpec = {
+  label: string;
+  shape: [number, number];
+  length: number;
+  seed: number;
+};
+
+const scanSpecs: ScanSpec[] = [
+  { label: "8x7 x1", shape: [8, 7], length: 1, seed: 20 },
+  { label: "8x7 x8", shape: [8, 7], length: 8, seed: 21 },
+  { label: "16x8 x1", shape: [16, 8], length: 1, seed: 22 },
+  { label: "16x8 x8", shape: [16, 8], length: 8, seed: 23 },
+];
+
+async function warmupScan(fn: () => [np.Array, np.Array]) {
+  const [carry, ys] = fn();
+  await blockUntilReady([carry, ys]);
+  carry.dispose();
+  ys.dispose();
+}
+
+const scanCases: Array<{
+  spec: ScanSpec;
+  init: np.Array;
+  publicF: (x: np.Array) => [np.Array, np.Array];
+  primitiveF: (x: np.Array) => [np.Array, np.Array];
+}> = [];
+for (const spec of scanSpecs) {
+  const init = makeMatrix(spec.shape, spec.seed);
+  const publicF = jit((x: np.Array) =>
+    lax.scan(
+      (carry) => np.linalg.qr(carry),
+      x,
+      null,
+      { length: spec.length, acceptPath: "compiled-loop" },
+    ),
+  ) as (x: np.Array) => [np.Array, np.Array];
+  const primitiveF = jit((x: np.Array) =>
+    lax.scan(
+      (carry) => primitiveQr(carry) as [np.Array, np.Array],
+      x,
+      null,
+      { length: spec.length },
+    ),
+  ) as (x: np.Array) => [np.Array, np.Array];
+  await warmupScan(() => publicF(init));
+  await warmupScan(() => primitiveF(init));
+  scanCases.push({ spec, init, publicF, primitiveF });
+}
+
+afterAll(() => {
+  for (const { init, publicF, primitiveF } of scanCases) {
+    init.dispose();
+    (publicF as unknown as { dispose: () => void }).dispose();
+    (primitiveF as unknown as { dispose: () => void }).dispose();
+  }
+});
+
+describe("QR cutoff (WASM nested scan)", () => {
+  for (const { spec, init, publicF, primitiveF } of scanCases) {
+    bench(`public scan ${spec.label}`, async () => {
+      const [carry, ys] = publicF(init);
+      await blockUntilReady([carry, ys]);
+      carry.dispose();
+      ys.dispose();
+    });
+
+    bench(`primitive scan ${spec.label}`, async () => {
+      const [carry, ys] = primitiveF(init);
+      await blockUntilReady([carry, ys]);
+      carry.dispose();
+      ys.dispose();
+    });
+  }
+});
+
+type BlockMapSpec = {
+  label: string;
+  shape: [number, number];
+  batch: number;
+  seed: number;
+};
+
+const blockMapSpecs: BlockMapSpec[] = [
+  { label: "8x7 b1", shape: [8, 7], batch: 1, seed: 30 },
+  { label: "8x7 b8", shape: [8, 7], batch: 8, seed: 31 },
+  { label: "16x8 b1", shape: [16, 8], batch: 1, seed: 32 },
+  { label: "16x8 b8", shape: [16, 8], batch: 8, seed: 33 },
+];
+
+async function warmupBlockMap(fn: () => np.Array) {
+  const out = fn();
+  await blockUntilReady(out);
+  out.dispose();
+}
+
+const blockMapCases: Array<{
+  spec: BlockMapSpec;
+  xs: np.Array;
+  publicF: (x: np.Array) => np.Array;
+  primitiveF: (x: np.Array) => np.Array;
+}> = [];
+for (const spec of blockMapSpecs) {
+  const xs = makeMatrix([spec.batch, spec.shape[0] * spec.shape[1]] as [number, number], spec.seed)
+    .reshape([spec.batch, spec.shape[0], spec.shape[1]]);
+  const publicF = jit((x: np.Array) =>
+    lax.blockMap(
+      (block: np.Array) => {
+        const [q, r] = np.linalg.qr(block);
+        using _q = q;
+        using _r = r;
+        using qSum = np.sum(q);
+        using rSum = np.sum(r);
+        return np.add(qSum, rSum);
+      },
+      x,
+      { blockShape: [1], inAxes: [0], outAxes: [0] },
+    ),
+  ) as (x: np.Array) => np.Array;
+  const primitiveF = jit((x: np.Array) =>
+    lax.blockMap(
+      (block: np.Array) => {
+        const [q, r] = primitiveQr(block) as [np.Array, np.Array];
+        using _q = q;
+        using _r = r;
+        using qSum = np.sum(q);
+        using rSum = np.sum(r);
+        return np.add(qSum, rSum);
+      },
+      x,
+      { blockShape: [1], inAxes: [0], outAxes: [0] },
+    ),
+  ) as (x: np.Array) => np.Array;
+  await warmupBlockMap(() => publicF(xs));
+  await warmupBlockMap(() => primitiveF(xs));
+  blockMapCases.push({ spec, xs, publicF, primitiveF });
+}
+
+afterAll(() => {
+  for (const { xs, publicF, primitiveF } of blockMapCases) {
+    xs.dispose();
+    (publicF as unknown as { dispose: () => void }).dispose();
+    (primitiveF as unknown as { dispose: () => void }).dispose();
+  }
+});
+
+describe("QR cutoff (WASM nested block_map)", () => {
+  for (const { spec, xs, publicF, primitiveF } of blockMapCases) {
+    bench(`public block_map ${spec.label}`, async () => {
+      const out = publicF(xs);
+      await blockUntilReady(out);
+      out.dispose();
+    });
+
+    bench(`primitive block_map ${spec.label}`, async () => {
+      const out = primitiveF(xs);
+      await blockUntilReady(out);
+      out.dispose();
+    });
+  }
+});
