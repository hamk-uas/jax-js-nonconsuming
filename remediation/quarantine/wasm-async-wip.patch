+type WorkspaceSectionSpec<T extends string> = {
+  key: T;
+  sizes: readonly number[];
+};
+
+type WorkspacePlan<T extends string> = {
+  totalSize: number;
+  offsets: Record<T, number[]>;
+};
+
+const WASM_WORKSPACE_ALIGN = 64;
+
+function alignWasmWorkspaceSize(size: number): number {
+  return Math.ceil(size / WASM_WORKSPACE_ALIGN) * WASM_WORKSPACE_ALIGN;
+}
+
+function computeAlignedWorkspaceLayout(sizes: readonly number[]): {
+  totalSize: number;
+  offsets: number[];
+} {
+  const offsets: number[] = [];
+  let totalSize = 0;
+  for (const size of sizes) {
+    offsets.push(totalSize);
+    totalSize += alignWasmWorkspaceSize(size);
+  }
+  return { totalSize, offsets };
+}
+
+function computeWorkspacePlan<T extends string>(
+  sections: readonly WorkspaceSectionSpec<T>[],
+): WorkspacePlan<T> {
+  const offsets = {} as Record<T, number[]>;
+  let totalSize = 0;
+  for (const section of sections) {
+    const layout = computeAlignedWorkspaceLayout(section.sizes);
+    offsets[section.key] = layout.offsets.map((offset) => totalSize + offset);
+    totalSize += layout.totalSize;
+  }
+  return { totalSize, offsets };
+}
